{
    "name": "burstfx",
    "version": "0.1.0",
    "description": "Small canvas particle effects for React: bursts, fire, confetti, fireworks, rockets and more.",
    "license": "MIT",
    "author": "Jason Brown",
    "repository": "github:loktar00/burstfx",
    "keywords": [
        "react",
        "particles",
        "canvas",
        "effects",
        "confetti",
        "fireworks",
        "animation"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepare": "npm run build",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
